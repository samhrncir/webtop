{
  "manifest_version": 3,
  "name": "BrowserHome Companion",
  "version": "1.0.1",
  "description": "Lets BrowserHome bookmarks open browser-internal pages such as chrome://extensions, which web pages cannot open on their own.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://browserhome.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://browserhome.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
